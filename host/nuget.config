<?xml version="1.0" encoding="utf-8"?>
<!--
  仓库级 NuGet 配置。

  为什么需要这个文件：本机的网络把 nuget.org 的请求 302 到国内镜像，
  而 NuGet 客户端不一定跟随该跳转，导致 NU1100 无法解析包。
  这里显式列出国内镜像 + nuget.org 作为后备。

  这个文件只影响本仓库，不修改用户全局 NuGet.Config。
-->
<configuration>
  <packageSources>
    <clear />
    <!-- 国内镜像。只用镜像：本机到 api.nuget.org 的大包传输会中断
         （实测 25MB+ 的运行时包下到一半断流），掉回 nuget.org 会导致
         "response ended prematurely" 并损坏 NuGet 缓存。
         曾用本地 local-packages/ 目录预下载规避，包已进全局缓存后不再需要。 -->
    <add key="nuget.azure.cn" value="https://nuget.azure.cn/v3/index.json" protocolVersion="3" />
  </packageSources>

  <packageRestore>
    <add key="enabled" value="true" />
    <add key="automatic" value="true" />
  </packageRestore>

  <bindingRedirects>
    <add key="skip" value="false" />
  </bindingRedirects>

  <packageManagement>
    <add key="format" value="0" />
    <add key="disabled" value="false" />
  </packageManagement>
</configuration>
