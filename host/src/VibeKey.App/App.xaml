<Application x:Class="VibeKey.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="Views/MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 主题资源由 ThemeManager.SetTheme 在 OnStartup 时注入：
                     色板（C# 创建的 SolidColorBrush）放直接 Resources，
                     样式字典（Themes/BaseStyles.xaml，用 DynamicResource 引用色板键）
                     放 MergedDictionaries。 -->
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
