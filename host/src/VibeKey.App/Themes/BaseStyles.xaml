<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============ 文字 ============ -->
    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
        <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI, sans-serif" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>

    <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Margin" Value="0,0,0,14" />
    </Style>

    <Style x:Key="Muted" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
    </Style>

    <Style x:Key="Faint" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="Foreground" Value="{DynamicResource TextFaint}" />
    </Style>

    <Style x:Key="Small" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style x:Key="Tiny" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="11" />
    </Style>

    <!-- ============ 卡片 ============ -->
    <!-- 普通卡片：白底、粗黑边、大圆角、右下硬阴影 -->
    <Style x:Key="CardBorder" TargetType="Border">
        <Setter Property="Background" Value="#FFFFFF" />
        <Setter Property="BorderBrush" Value="#1A1A1A" />
        <Setter Property="BorderThickness" Value="2.5" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="Margin" Value="0,0,0,18" />

    </Style>

    <!-- 强调卡片：亮黄底（图里那张"我们的解法"卡片） -->
    <Style x:Key="CardBorderAccent" TargetType="Border" BasedOn="{StaticResource CardBorder}">
        <Setter Property="Background" Value="{DynamicResource CardAccent}" />
    </Style>

    <!-- 分割线 -->
    <Style x:Key="SepStyle" TargetType="Separator">
        <Setter Property="Background" Value="{DynamicResource Divider}" />
        <Setter Property="Margin" Value="0,14,0,14" />
    </Style>

    <!-- ============ 按钮 ============ -->
    <!-- 主按钮：亮粉底、粗黑边、硬阴影；悬停阴影缩小（像被按下去） -->
    <Style TargetType="Button">
        <Setter Property="Padding" Value="16,9" />
        <Setter Property="MinWidth" Value="92" />
        <Setter Property="Margin" Value="0,0,10,0" />
        <Setter Property="Background" Value="{DynamicResource Accent}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="BtnBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource Border}"
                            BorderThickness="2.5"
                            CornerRadius="10"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <Border.Effect>
                            <DropShadowEffect Color="#1A1A1A" Opacity="1"
                                              BlurRadius="0" ShadowDepth="4" Direction="315" />
                        </Border.Effect>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource AccentHover}" />
                            <Setter Property="Effect" TargetName="BtnBorder">
                                <Setter.Value>
                                    <DropShadowEffect Color="#1A1A1A" Opacity="1"
                                                      BlurRadius="0" ShadowDepth="2" Direction="315" />
                                </Setter.Value>
                            </Setter>
                            <Setter Property="RenderTransform" TargetName="BtnBorder">
                                <Setter.Value>
                                    <TranslateTransform X="1" Y="1" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="{DynamicResource AccentPressed}" />
                            <Setter Property="Effect" TargetName="BtnBorder">
                                <Setter.Value>
                                    <DropShadowEffect Color="#1A1A1A" Opacity="1"
                                                      BlurRadius="0" ShadowDepth="0" Direction="315" />
                                </Setter.Value>
                            </Setter>
                            <Setter Property="RenderTransform" TargetName="BtnBorder">
                                <Setter.Value>
                                    <TranslateTransform X="2" Y="2" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Background" Value="{DynamicResource Divider}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextFaint}" />
                            <Setter Property="Cursor" Value="No" />
                            <Setter Property="Effect" TargetName="BtnBorder">
                                <Setter.Value>
                                    <DropShadowEffect Opacity="0" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 次按钮：白底黑边硬阴影 -->
    <Style x:Key="Secondary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{DynamicResource Card}" />
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="BtnBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource Border}"
                            BorderThickness="2.5"
                            CornerRadius="10"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <Border.Effect>
                            <DropShadowEffect Color="#1A1A1A" Opacity="1"
                                              BlurRadius="0" ShadowDepth="4" Direction="315" />
                        </Border.Effect>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource CardHover}" />
                            <Setter Property="Effect" TargetName="BtnBorder">
                                <Setter.Value>
                                    <DropShadowEffect Color="#1A1A1A" Opacity="1"
                                                      BlurRadius="0" ShadowDepth="2" Direction="315" />
                                </Setter.Value>
                            </Setter>
                            <Setter Property="RenderTransform" TargetName="BtnBorder">
                                <Setter.Value>
                                    <TranslateTransform X="1" Y="1" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="{DynamicResource AccentSubtle}" />
                            <Setter Property="Effect" TargetName="BtnBorder">
                                <Setter.Value>
                                    <DropShadowEffect Color="#1A1A1A" Opacity="1"
                                                      BlurRadius="0" ShadowDepth="0" Direction="315" />
                                </Setter.Value>
                            </Setter>
                            <Setter Property="RenderTransform" TargetName="BtnBorder">
                                <Setter.Value>
                                    <TranslateTransform X="2" Y="2" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Background" Value="{DynamicResource Divider}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextFaint}" />
                            <Setter Property="Cursor" Value="No" />
                            <Setter Property="Effect" TargetName="BtnBorder">
                                <Setter.Value>
                                    <DropShadowEffect Opacity="0" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 幽灵按钮：无边框，只变色 -->
    <Style x:Key="Ghost" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource AccentSubtle}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ 输入框 ============ -->
    <Style TargetType="TextBox">
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="Background" Value="{DynamicResource Card}" />
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Accent}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource AccentSubtle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="InputBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource FocusRing}" />
                            <Setter Property="BorderThickness" Value="2.5" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Background" Value="{DynamicResource Bg}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextFaint}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ 下拉框 ============ -->
    <Style TargetType="ComboBox">
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="Background" Value="{DynamicResource Card}" />
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
    </Style>

    <!-- ============ 勾选框 ============ -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <!-- ============ 进度条 ============ -->
    <Style TargetType="ProgressBar">
        <Setter Property="Height" Value="10" />
        <Setter Property="Foreground" Value="{DynamicResource Accent}" />
        <Setter Property="Background" Value="{DynamicResource Divider}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border x:Name="PART_Track"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5" />
                        <Border x:Name="PART_Indicator"
                                Background="{TemplateBinding Foreground}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="2"
                                CornerRadius="5"
                                HorizontalAlignment="Left" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ 列表框 ============ -->
    <Style TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="4" />
    </Style>

    <Style TargetType="ListBoxItem">
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="Margin" Value="0,2,0,2" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border Background="Transparent"
                            BorderBrush="{DynamicResource Border}"
                            BorderThickness="0"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource CardHover}" />
                            <Setter Property="BorderThickness" Value="1.5" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{DynamicResource AccentSubtle}" />
                            <Setter Property="BorderThickness" Value="1.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
