<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         VibeKey 浅色主题
         设计语言参照 shadcn/ui：背景分层、卡片留白、克制的强调色、
         避免大面积紫色/靛蓝（PRD 6.1）。
         ============================================================ -->

    <!-- 背景层级：最底 -> 卡片 -> 弹层 -->
    <SolidColorBrush x:Key="Bg"        Color="#F4F5F7" />
    <SolidColorBrush x:Key="Card"      Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardHover" Color="#FAFBFC" />
    <SolidColorBrush x:Key="Overlay"   Color="#FFFFFF" />

    <!-- 边框：默认 -> 强调（用于卡片悬停） -->
    <SolidColorBrush x:Key="Border"      Color="#E4E7EC" />
    <SolidColorBrush x:Key="BorderStrong" Color="#CBD1D8" />

    <!-- 文字层级 -->
    <SolidColorBrush x:Key="Text"        Color="#1C1E21" />
    <SolidColorBrush x:Key="TextMuted"   Color="#6A6F76" />
    <SolidColorBrush x:Key="TextFaint"   Color="#9A9FA6" />

    <!-- 强调色（主按钮、链接、进度条） -->
    <SolidColorBrush x:Key="Accent"        Color="#2F6FEB" />
    <SolidColorBrush x:Key="AccentHover"   Color="#2A5FD0" />
    <SolidColorBrush x:Key="AccentPressed" Color="#2451B8" />
    <SolidColorBrush x:Key="AccentSubtle"  Color="#EAF1FE" />
    <SolidColorBrush x:Key="AccentSubtleHover" Color="#DDE7FD" />

    <!-- 状态色 -->
    <SolidColorBrush x:Key="Ok"        Color="#1A7F37" />
    <SolidColorBrush x:Key="OkSubtle"  Color="#E8F5EC" />
    <SolidColorBrush x:Key="Warn"      Color="#BF8700" />
    <SolidColorBrush x:Key="WarnSubtle" Color="#FDF5E0" />
    <SolidColorBrush x:Key="Bad"       Color="#CF222E" />
    <SolidColorBrush x:Key="BadSubtle"  Color="#FDECEE" />

    <!-- 分割线 -->
    <SolidColorBrush x:Key="Divider" Color="#EDEFF2" />

    <!-- 输入框聚焦 -->
    <SolidColorBrush x:Key="FocusRing" Color="#2F6FEB" />

</ResourceDictionary>
