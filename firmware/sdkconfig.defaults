# VibeKey 固件默认配置
# 目标：ESP32-S3，C，ESP-IDF（GCC 工具链）
# 详见 docs/00-技术设计文档.md

CONFIG_IDF_TARGET="esp32s3"

# ---- 版本信息 ----
CONFIG_VIBEKEY_FW_VERSION="0.1.0"

# ---- USB：TinyUSB CDC（虚拟 COM 口，Windows 自带驱动）----
CONFIG_TINYUSB_CDC_ENABLED=y

# ---- WiFi ----
CONFIG_ESP_WIFI_ENABLED=y
CONFIG_VIBEKEY_TCP_PORT=8266
CONFIG_VIBEKEY_DISCOVERY_PORT=8267

# ---- AP 配网模式 ----
# ⚠️ 占位值，量产前必须替换为开发者统一生成的随机串，
#    并印刷在产品说明书首页（设计文档 §7.2）
CONFIG_VIBEKEY_AP_PASSWORD="Vb7Kq2mXv9"
CONFIG_VIBEKEY_AP_MAX_CONN=4

# ---- 按键释放帧（0x05）默认关闭，需要"按住说话"流式语音时打开 ----
CONFIG_VIBEKEY_SEND_KEY_RELEASE=n

# ---- 日志：UART0 保留给 ESP-IDF 日志，UART1 是业务调试口 ----
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_NUM=0

# ---- 可靠性：看门狗 ----
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10
CONFIG_ESP_INT_WDT_EN=y

# ---- 音频：整包模式 60s = 1.92MB，必须放 PSRAM（设计文档 §5.5）----
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# ---- flash：BOM 是 ESP32-S3-WROOM-1-N16R8（16MB flash + 8MB PSRAM）----
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# ---- 分区表：用项目自带的 partitions.csv（app 2MB），不用 ESP-IDF 默认的 ----
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# ---- 性能 ----
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000

# ---- 裁掉键盘用不到的外设（安全、不影响 WiFi/USB/I2S/按键）----
# 这些驱动默认都编进来，但键盘一个都用不到：
# 没屏幕、没摄像头、没 SD 卡、没 DAC/LEDC/MCPWM/RMT/TOUCH/TWAI/PARLIO/SDIO。
# 只保留 GPIO/UART/I2C/I2S/PCNT/ADC/SPI 这些真在用的。
CONFIG_DRIVER_LCD_ENABLED=n
CONFIG_DRIVER_CAMERA_ENABLED=n
CONFIG_DRIVER_DVP_ENABLED=n
CONFIG_DRIVER_SDMMC_ENABLED=n
CONFIG_DRIVER_SDIO_ENABLED=n
CONFIG_DRIVER_SDSPI_ENABLED=n
CONFIG_DRIVER_DAC_ENABLED=n
CONFIG_DRIVER_LEDC_ENABLED=n
CONFIG_DRIVER_MCPWM_ENABLED=n
CONFIG_DRIVER_RMT_ENABLED=n
CONFIG_DRIVER_TOUCH_SENS_ENABLED=n
CONFIG_DRIVER_TWAI_ENABLED=n
CONFIG_DRIVER_PARLIO_ENABLED=n
CONFIG_DRIVER_ANA_CMPR_ENABLED=n
CONFIG_DRIVER_SDM_ENABLED=n
CONFIG_DRIVER_TSENS_ENABLED=n
CONFIG_DRIVER_I2S_TDM_ENABLED=n
CONFIG_DRIVER_UART_IRAM_FOR_ALLOC=n

# ---- 关闭不需要的特性，减小攻击面与固件体积 ----
# 键盘只用 WiFi + USB，不用蓝牙/Thread/Zigbee。M4 加了 WebSocket+TLS 后
# 固件接近 1MB 分区上限，必须把这些裁掉。
CONFIG_BT_ENABLED=n
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=n
CONFIG_OPENTHREAD_ENABLED=n
CONFIG_IEEE802154_ENABLED=n
