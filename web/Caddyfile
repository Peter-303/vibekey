# VibeKey Caddy 配置
# 自动签 Let's Encrypt SSL 证书，反向代理到后端。
#
# DOMAIN 环境变量由 docker-compose 传入（如 vibekey.example.com）。
# localhost 时 Caddy 用自签名证书（仅本地测试）。

{$DOMAIN} {
    # 反向代理：所有请求（HTTP API + 静态文件 + WebSocket）都到后端
    reverse_proxy backend:8080

    # WebSocket 需要的头（Caddy 默认会正确处理 Upgrade）
    # 压缩静态资源
    encode gzip

    # 安全头
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
    }

    # 访问日志
    log {
        output stdout
        format json
    }
}
